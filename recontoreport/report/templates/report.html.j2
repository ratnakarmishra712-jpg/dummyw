<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Security Assessment Report — {{ target.url if target else "unknown" }}</title>
<style>
  :root{
    --bg:#0b0b0d; --panel:#131316; --fg:#ececec; --mut:#8c8c93; --bd:#262629;
    --accent:#5b8cff; --green:#38e07a;
    --critical:#b14cff; --high:#ff4d4d; --medium:#f2a100; --low:#f2c200; --info:#5b8cff;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);font-family:"Helvetica Neue",Arial,sans-serif;line-height:1.6;font-size:15px}
  .wrap{max-width:900px;margin:0 auto;padding:0 20px 90px}
  .mono{font-family:ui-monospace,Menlo,Consolas,monospace}
  /* cover */
  .cover{padding:64px 0 40px;border-bottom:1px solid var(--bd);margin-bottom:28px}
  .brand{font-size:1.4rem;font-weight:900;letter-spacing:-.03em}.brand b{color:var(--green)}
  .cover h1{font-size:2.1rem;font-weight:800;margin:26px 0 6px;letter-spacing:-.02em}
  .cover .meta{color:var(--mut);font-size:.85rem;margin-top:14px}
  .cover .meta span{color:var(--fg)}
  /* summary */
  h2{font-size:1.15rem;font-weight:800;margin:36px 0 12px;padding-bottom:8px;border-bottom:1px solid var(--bd)}
  .kpis{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}
  .kpi{flex:1;min-width:110px;background:var(--panel);border:1px solid var(--bd);border-radius:10px;padding:14px}
  .kpi .n{font-size:1.8rem;font-weight:800;line-height:1}.kpi .l{font-size:.68rem;color:var(--mut);text-transform:uppercase;letter-spacing:.1em;margin-top:6px}
  .kpi.critical .n{color:var(--critical)}.kpi.high .n{color:var(--high)}.kpi.medium .n{color:var(--medium)}.kpi.low .n{color:var(--low)}.kpi.info .n{color:var(--info)}
  table.toc{width:100%;border-collapse:collapse;font-size:.88rem;margin-top:8px}
  table.toc td,table.toc th{border-bottom:1px solid var(--bd);padding:8px 6px;text-align:left}
  table.toc th{color:var(--mut);font-size:.68rem;text-transform:uppercase;letter-spacing:.08em}
  .badge{display:inline-block;padding:2px 9px;border-radius:4px;font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:#000}
  .b-critical{background:var(--critical);color:#fff}.b-high{background:var(--high);color:#fff}.b-medium{background:var(--medium)}.b-low{background:var(--low)}.b-info{background:var(--info);color:#fff}
  /* finding */
  .finding{background:var(--panel);border:1px solid var(--bd);border-radius:12px;padding:22px 24px;margin:20px 0}
  .finding .fid{color:var(--mut);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}
  .finding h3{font-size:1.25rem;font-weight:800;margin:4px 0 14px}
  .kv{display:grid;grid-template-columns:140px 1fr;gap:8px 14px;font-size:.9rem;margin-bottom:16px}
  .kv .k{color:var(--mut);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;padding-top:2px}
  .sec{margin:14px 0}.sec h4{font-size:.74rem;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);margin:0 0 5px}
  pre{background:#000;border:1px solid var(--bd);border-radius:6px;padding:11px;overflow-x:auto;font-size:.82rem;white-space:pre-wrap;color:#c9d1d9;margin:0}
  a{color:var(--accent);word-break:break-all}
  .assets{width:100%;border-collapse:collapse;font-size:.8rem}
  .assets td,.assets th{border:1px solid var(--bd);padding:6px 8px;text-align:left}
  .assets th{background:#000;color:var(--mut);font-size:.66rem;text-transform:uppercase}
  .empty{color:var(--mut);font-style:italic}
  footer{margin-top:50px;color:var(--mut);font-size:.72rem;border-top:1px solid var(--bd);padding-top:16px}
  .chain{display:flex;gap:0;flex-wrap:wrap;margin:14px 0 8px}
  .stage{flex:1;min-width:120px;background:var(--panel);border:1px solid var(--bd);border-right:none;padding:12px 10px}
  .stage:last-child{border-right:1px solid var(--bd)}
  .stage.hit{border-color:var(--high);box-shadow:inset 0 0 0 1px var(--high)}
  .stage .t{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:var(--mut)}
  .stage.hit .t{color:var(--high)}
  .stage .c{font-size:1.5rem;font-weight:800;margin-top:4px}
  .stage.hit .c{color:var(--high)}.stage.miss .c{color:var(--bd)}
  .narr{background:#000;border:1px solid var(--high);border-radius:8px;padding:14px 16px;margin:10px 0;font-size:.92rem}
  .ttag{display:inline-block;background:#000;border:1px solid var(--accent);color:var(--accent);border-radius:4px;padding:1px 7px;font-size:.72rem;font-family:ui-monospace,Menlo,Consolas,monospace}
  @media print{body{background:#fff;color:#111}.finding,.kpi,.stage{background:#fff}}
</style>
</head>
<body>
{% set cvss = {"critical":"9.1 (Critical)","high":"7.5 (High)","medium":"5.3 (Medium)","low":"3.1 (Low)","info":"0.0 (Info)"} %}
{% set vector = {"critical":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","high":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","medium":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:L/A:N","low":"CVSS:3.1/AV:N/AC:H/PR:L/UI:R/S:U/C:L/I:N/A:N","info":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N"} %}
{% set biz = {
  "critical":"Exploitation could lead to full compromise of the application or its data, resulting in major financial, legal and reputational damage.",
  "high":"An attacker could access or manipulate sensitive data or user sessions, causing significant breach-of-trust and compliance exposure.",
  "medium":"Could be chained with other weaknesses to access restricted data or affect users, degrading trust and increasing breach likelihood.",
  "low":"Limited direct impact, but contributes to overall attack surface and may aid an attacker during reconnaissance.",
  "info":"No direct business impact; recorded for completeness and situational awareness."} %}
<div class="wrap">
  <div class="cover">
    <div class="brand">RECON<b>//</b>REPORT</div>
    <h1>Web Application<br>Security Assessment</h1>
    <div class="meta">
      Target: <span>{{ target.url if target else "n/a" }}</span><br>
      {% if target and target.engagement_ref %}Engagement: <span>{{ target.engagement_ref }}</span><br>{% endif %}
      Date: <span>{{ generated_at }}</span><br>
      Classification: <span>Confidential</span>
    </div>
  </div>

  <h2>Executive Summary</h2>
  <p>This assessment was conducted under explicit written authorization and limited to the agreed scope.
     {{ total_findings }} finding(s) were identified across {{ asset_count }} discovered asset(s). The table
     below summarizes severity distribution; each finding is detailed in the following section with impact and
     remediation guidance.</p>
  {% set gcolor = {"green":"var(--green)","yellow":"var(--medium)","red":"var(--high)"}[grade.color] %}
  <div style="display:flex;gap:18px;align-items:center;margin:14px 0 6px">
    <div style="font-size:3rem;font-weight:800;width:78px;height:78px;border:3px solid {{ gcolor }};color:{{ gcolor }};border-radius:14px;display:flex;align-items:center;justify-content:center">{{ grade.grade }}</div>
    <div><div style="font-size:.7rem;color:var(--mut);text-transform:uppercase;letter-spacing:.08em">Security grade</div>
      <div style="font-size:1.1rem;font-weight:800">{{ grade.score }} / 100</div>
      <div style="color:var(--mut);font-size:.85rem">{{ grade.label }}</div></div>
  </div>
  <div class="kpis">
    {% for sev in severity_order %}
    <div class="kpi {{ sev }}"><div class="n">{{ counts.get(sev, 0) }}</div><div class="l">{{ sev }}</div></div>
    {% endfor %}
  </div>
  {% if findings %}<div class="narr" style="border-color:var(--high)"><b>Attacker's-eye view — </b>{{ attacker_story }}</div>{% endif %}

  {% if findings %}
  <h2>Attack Path — MITRE ATT&amp;CK</h2>
  <p>Findings are mapped to adversary tactics and assembled into a simulated kill chain — showing not just
     <em>what</em> is weak but how an attacker would chain these weaknesses end-to-end.</p>
  <div class="narr"><b>&#9654; </b>{{ attack.narrative }}</div>
  <div class="chain">
    {% for t in attack.by_tactic.keys() %}{% set hit = attack.by_tactic[t]|length %}
    <div class="stage {{ 'hit' if hit else 'miss' }}"><div class="t">{{ t }}</div><div class="c">{{ hit }}</div></div>
    {% endfor %}
  </div>

  <h2>Findings Overview</h2>
  <table class="toc">
    <thead><tr><th>#</th><th>Finding</th><th>Severity</th><th>CWE</th></tr></thead>
    <tbody>
    {% set ns = namespace(i=0) %}
    {% for sev in severity_order if grouped_findings.get(sev) %}{% for f in grouped_findings[sev] %}{% set ns.i = ns.i + 1 %}
      <tr><td>{{ "%02d"|format(ns.i) }}</td><td>{{ f.title }}</td>
      <td><span class="badge b-{{ f.severity }}">{{ f.severity }}</span></td><td>{{ f.cwe_id or "—" }}</td></tr>
    {% endfor %}{% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h2>Detailed Findings</h2>
  {% if not grouped_findings %}<p class="empty">No findings were identified in the tested scope.</p>{% endif %}
  {% set ns2 = namespace(i=0) %}
  {% for sev in severity_order if grouped_findings.get(sev) %}{% for f in grouped_findings[sev] %}{% set ns2.i = ns2.i + 1 %}
  <div class="finding">
    <div class="fid">Finding {{ "%02d"|format(ns2.i) }} · {{ f.tool_source or "manual" }}</div>
    <h3>{{ f.title }}</h3>
    <div class="kv">
      <div class="k">Affected URL</div><div>{{ f.asset.url if f.asset else target.url }}</div>
      <div class="k">Severity</div><div><span class="badge b-{{ f.severity }}">{{ f.severity }}</span></div>
      <div class="k">CVSS</div><div>{{ cvss[f.severity] }} <span class="mono" style="color:var(--mut);font-size:.78rem">{{ vector[f.severity] }}</span></div>
      <div class="k">CWE / OWASP</div><div>{{ f.cwe_id or "—" }}{% if f.owasp_category %} · {{ f.owasp_category }}{% endif %}</div>
      {% set atk = attack_technique(f) %}
      <div class="k">MITRE ATT&amp;CK</div><div><a class="ttag" href="{{ atk.url }}" target="_blank">{{ atk.id }} {{ atk.name }}</a></div>
      <div class="k">Confidence</div><div>{{ f.confidence }}</div>
    </div>
    {% if f.description %}<div class="sec"><h4>Description</h4><div>{{ f.description }}</div></div>{% endif %}
    <div class="sec"><h4>Business Impact</h4><div>{{ biz[f.severity] }}</div></div>
    {% if f.poc_steps %}<div class="sec"><h4>Proof of Concept</h4><pre>{{ f.poc_steps }}</pre></div>{% endif %}
    {% if f.remediation %}<div class="sec"><h4>Suggested Remediation</h4><div>{{ f.remediation }}</div></div>{% endif %}
  </div>
  {% endfor %}{% endfor %}

  <h2>Appendix — Discovered Assets</h2>
  {% if assets %}
  <table class="assets">
    <thead><tr><th>Type</th><th>URL</th><th>Method</th><th>Source</th></tr></thead>
    <tbody>{% for a in assets %}<tr><td>{{ a.type }}</td><td>{{ a.url }}</td><td>{{ a.method or "—" }}</td><td>{{ a.source_tool or "—" }}</td></tr>{% endfor %}</tbody>
  </table>
  {% else %}<p class="empty">No assets discovered.</p>{% endif %}

  {% if secrets %}
  <h2>Appendix — Secret Matches (unverified)</h2>
  <table class="assets">
    <thead><tr><th>Kind</th><th>Value</th></tr></thead>
    <tbody>{% for s in secrets %}<tr><td>{{ s.kind }}</td><td class="mono">{{ s.matched_value }}</td></tr>{% endfor %}</tbody>
  </table>
  {% endif %}

  <footer>ReconToReport · Confidential · For authorized security testing only. Generated {{ generated_at }}.</footer>
</div>
</body>
</html>
